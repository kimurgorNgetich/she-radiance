# SR-005a: Streamlit Cloud secrets template.
#
# Copy this file to .streamlit/secrets.toml and fill in real values for local
# Streamlit runs. .streamlit/secrets.toml is gitignored — never commit real
# secrets. On Streamlit Community Cloud, paste the equivalent contents into
# the app's Settings > Secrets panel instead of committing a file.

# Anthropic API key used by backend/vision_client.py.
ANTHROPIC_API_KEY = "sk-ant-..."

# Managed Postgres connection string (preferred for cloud deploys). If set,
# backend/database.py uses this and ignores the discrete DB_* keys below.
DATABASE_URL = "postgresql://user:password@host:port/dbname"

# Discrete connection params, used only when DATABASE_URL is not set.
# DB_HOST = "127.0.0.1"
# DB_PORT = "5432"
# DB_NAME = "she_radiance"
# DB_USER = "postgres"
# DB_PASSWORD = "changeme"
